# Optional real-LLM mode. Leave unset (or LLM_MODE=templated) and the demo runs fully offline.
# Everything here is read ONLY by the Vite dev server (vite.config.ts) and never shipped to the browser.
LLM_MODE=templated            # templated | openai | gemini

# --- LLM_MODE=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM_MODE=gemini (Gemini on Google Cloud / Vertex AI) — no API key ---
# Auth is Application Default Credentials already in the environment, e.g.
#   gcloud auth application-default login --impersonate-service-account=sa-aichat@<project>.iam.gserviceaccount.com
# or GOOGLE_APPLICATION_CREDENTIALS, or the GCE/Cloud Run metadata server.
GOOGLE_CLOUD_PROJECT=                       # falls back to the ADC / gcloud project
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=         # optional: impersonate this SA on top of whatever ADC is present
