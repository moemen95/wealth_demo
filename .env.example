# Root .env — read by `make …` targets (sourced into the shell), by the backend (process.env) and by
# the Vite dev server (server-side only; nothing but VITE_* ever reaches the browser).
# Shell variables take precedence over this file:  LLM_MODE=gemini make dev

# --- Ports / wiring ---
FRONTEND_PORT=5173
BACKEND_PORT=8787
# BACKEND_URL=http://localhost:8787     # set → the frontend proxies /api here instead of mounting it in-process
CORS_ORIGINS=http://localhost:5173      # comma-separated; the backend only allows these origins

# --- AI summary mode: templated | openai | gemini  (leave templated to run fully offline) ---
LLM_MODE=templated

# LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM_MODE=gemini — Gemini on Google Cloud (Vertex AI), no API key. Auth = Application Default
# Credentials already in the environment, e.g.
#   gcloud auth application-default login --impersonate-service-account=sa-aichat@<project>.iam.gserviceaccount.com
# or GOOGLE_APPLICATION_CREDENTIALS, or the GCE/Cloud Run metadata server.
GOOGLE_CLOUD_PROJECT=                   # falls back to the ADC / gcloud project
GOOGLE_CLOUD_LOCATION=us-central1       # a region, or `global` (bare aiplatform.googleapis.com host)
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=     # optional: impersonate this SA on top of whatever ADC is present
# GEMINI_THINKING_BUDGET=0              # optional: default 0 for 2.5 flash, 128 for 2.5 pro
# GEMINI_MAX_OUTPUT_TOKENS=             # optional; unset = no cap (a cap can truncate the JSON: thinking tokens count against it)
# OPENAI_MAX_COMPLETION_TOKENS=         # optional; unset = no cap (same reason for GPT-5 / o-series)
