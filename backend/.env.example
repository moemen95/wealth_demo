# ─────────────────────────────────────────────────────────────
# Provider selection — the ONLY switch between OpenAI and Gemini
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai            # openai | gemini

# ---- OpenAI (LLM_PROVIDER=openai) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://your-azure-or-proxy/v1   # optional

# ---- Gemini on Vertex AI (LLM_PROVIDER=gemini) ----
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-1.5-pro
# Cap on automatic-function-calling remote calls per generate_content request.
GOOGLE_AFC_MAX_REMOTE_CALLS=50
# Short-lived credentials via impersonation (no long-lived JSON keys):
GCP_IMPERSONATE_SERVICE_ACCOUNT=sa-agent@my-gcp-project.iam.gserviceaccount.com
# Or point at an ADC file (optional; prefer `gcloud auth application-default login`):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/adc.json

# ---- Server ----
CORS_ORIGINS=http://localhost:3000
